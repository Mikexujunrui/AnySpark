# AnySpark v4 — 真实模型配置示例（复制为 .env 填入你的 key）
#
# DEEPSEEK_* 是【启动种子】：空库时播种为第一条模型配置（model_configs 表）。
# 之后可在前端「模型选择器」或 API（GET/POST /api/models、POST /api/models/{id}/activate）
# 运行时增删改/切换供应商与模型（S47），无需改 .env 重启。
# 思考强度（off/low/medium/high/xhigh/max）也可按模型配置或请求级指定。
DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=sk-your-key-here
# 上下文窗口（token，驱动 token 预算 = 窗口×0.7；S26）
# DEEPSEEK_CONTEXT_WINDOW=1000000  # V4 系列原生 1M 上下文（预算 = 窗口*0.7）
